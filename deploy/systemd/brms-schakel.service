# systemd-service voor de schakellaag (ARCHITECTURE.md §3.1, §5.8).
#
# Dit is een sjabloon: deploy/install.sh en deploy/update.sh vullen @BRMS@ (de projectmap,
# bijv. /home/jandirk/BRMS) en @GEBRUIKER@ (bijv. jandirk) in en zetten het resultaat in
# /etc/systemd/system/. Beide scripts nemen elke unit in deze map mee: een nieuwe service
# wordt bij `brms update` vanzelf geïnstalleerd en gestart.

[Unit]
Description=BRMS schakellaag (beslist over de stand van de relais)
# Broker en netwerk eerst starten (§3.1 punt 6). 'Wants' i.p.v. 'Requires': valt de broker
# weg, dan blijft de schakellaag draaien en verbindt opnieuw zodra hij terug is.
Wants=mosquitto.service network-online.target
After=mosquitto.service network-online.target

[Service]
# Draait als de beheerder van de Pi (§10.1 punt 5).
User=@GEBRUIKER@
Environment=PYTHONPATH=@BRMS@
WorkingDirectory=@BRMS@
ExecStart=@BRMS@/.venv/bin/python -m brms schakel
# Altijd opnieuw starten na een crash of fout, na 5 s (§3.1 punt 1). Zolang de schakellaag
# weg is, zet elke Shelly zichzelf na de terugschakeltijd in zijn veilige stand (§5.8
# punt 5).
Restart=always
RestartSec=5

# Beperkingen: de schakellaag schrijft niets naar schijf (§5.8 punt 1). Systeem en home
# zijn alleen-lezen.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
