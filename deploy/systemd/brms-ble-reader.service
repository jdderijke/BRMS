# systemd-service voor de BLE-reader (ARCHITECTURE.md §3.1, §5.2.1).
# Geïnstalleerd in /etc/systemd/system/ door deploy/install.sh en deploy/update.sh.

[Unit]
Description=BRMS BLE-reader (Bluetooth-sensoren -> MQTT)
# Broker en Bluetooth eerst starten (§3.1 punt 6). 'Wants' i.p.v. 'Requires': valt de
# broker weg, dan blijft de reader draaien (en gooit metingen weg tot de broker terug is).
Wants=mosquitto.service bluetooth.service
After=mosquitto.service bluetooth.service

[Service]
# Eigen systeemgebruiker; groep 'bluetooth' geeft toegang tot BlueZ (§10.1 punt 5).
User=brms
Group=brms
Environment=PYTHONPATH=/opt/brms
ExecStart=/opt/brms/venv/bin/python -m brms ble-reader
# Altijd opnieuw starten na een crash of fout, na 5 s (§3.1 punt 1).
Restart=always
RestartSec=5

# Beveiliging: de service kan het systeem niet wijzigen en ziet geen home-mappen.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
