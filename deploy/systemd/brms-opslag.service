# systemd-service voor de opslag (ARCHITECTURE.md §3.1, §5.3).
#
# Dit is een sjabloon: deploy/install.sh en deploy/update.sh vullen @BRMS@ (de projectmap,
# bijv. /home/jandirk/BRMS) en @GEBRUIKER@ (bijv. jandirk) in en zetten het resultaat in
# /etc/systemd/system/.

[Unit]
Description=BRMS opslag (MQTT -> SQLite)
# Broker eerst starten (§3.1 punt 6). 'Wants': valt de broker weg, dan blijft de opslag
# draaien en verbindt opnieuw zodra hij terug is.
Wants=mosquitto.service
After=mosquitto.service

[Service]
# Draait als de beheerder van de Pi (§10.1 punt 5).
User=@GEBRUIKER@
Environment=PYTHONPATH=@BRMS@
WorkingDirectory=@BRMS@
ExecStart=@BRMS@/.venv/bin/python -m brms opslag
# Altijd opnieuw starten na een crash of fout, na 5 s (§3.1 punt 1).
Restart=always
RestartSec=5

# Beperkingen: systeem en home alleen-lezen, behalve data/ waar de database staat.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@BRMS@/data
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
