# systemd-service voor de webinterface (ARCHITECTURE.md §3.1, §5.6).
#
# Dit is een sjabloon: deploy/install.sh en deploy/update.sh vullen @BRMS@ (de projectmap,
# bijv. /home/jandirk/BRMS) en @GEBRUIKER@ (bijv. jandirk) in en zetten het resultaat in
# /etc/systemd/system/.

[Unit]
Description=BRMS web (Flask: grafieken van bus en database)
# 'Wants': valt de broker weg, dan blijft het web draaien (de database blijft leesbaar) en
# verbindt het opnieuw zodra de broker terug is.
Wants=mosquitto.service
After=mosquitto.service

[Service]
# Draait als de beheerder van de Pi (§10.1 punt 5).
User=@GEBRUIKER@
Environment=PYTHONPATH=@BRMS@
WorkingDirectory=@BRMS@
ExecStart=@BRMS@/.venv/bin/python -m brms web
# Altijd opnieuw starten na een crash of fout, na 5 s (§3.1 punt 1).
Restart=always
RestartSec=5

# Beperkingen: systeem en home alleen-lezen. Het web opent de database alleen-lezen en
# schrijft er nooit in (§5.6 punt 3), maar SQLite heeft bij een WAL-database ook als lezer
# schrijftoegang nodig tot het hulpbestand brms.db-shm in data/.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@BRMS@/data
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
